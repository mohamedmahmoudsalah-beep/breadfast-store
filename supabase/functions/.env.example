# Secrets for Edge Functions. Set them with:  npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; that file is git-ignored). SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
SITE_URL=https://YOUR-SITE.pages.dev
PAYMOB_SECRET_KEY=egy_sk_test_xxx
PAYMOB_PUBLIC_KEY=egy_pk_test_xxx
PAYMOB_INTEGRATION_ID=1234567
PAYMOB_HMAC_SECRET=xxxxxxxx
# optional
CRON_SECRET=long-random-string
PAYMOB_FALLBACK_PHONE=+201000000000
# PAYMOB_API_KEY=xxxx           # enables the extra server-to-server transaction check
# PAYMOB_BASE_URL=https://accept.paymob.com
